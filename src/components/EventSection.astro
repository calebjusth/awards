---
const events = [
  {
    title: "ETHIO-DIGITAL SUMMIT 2026",
    date: "14 MAY",
    location: "SKYLIGHT HOTEL, ADDIS ABABA",
    organizer: "HELM CREATIVES",
    organizerLogo: "https://images.unsplash.com/photo-1614850523296-e8c041de239b?q=80&w=100",
    poster: "https://images.unsplash.com/photo-1540575861501-7ad05823c9f5?q=80&w=2070",
    time: "09:00 AM"
  },
  {
    title: "DESIGN DISCOURSE: ARABIC & GE'EZ",
    date: "02 JUNE",
    location: "ICEADDIS, BOLE",
    organizer: "CREATIVE HUB ET",
    organizerLogo: "https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=100",
    poster: "https://images.unsplash.com/photo-1558655146-d09347e92766?q=80&w=1000",
    time: "06:30 PM"
  }
];
---

<section class="site-frame py-32 border-t border-ink/5">
    <div class="mb-24">
        <h2 class="text-primary font-body font-black text-xl tracking-[0.2em] uppercase mb-4">Community</h2>
        <h1 class="text-7xl md:text-9xl font-title leading-[0.8]">Upcoming<br/>Events</h1>
    </div>

    <div class="flex flex-col gap-40">
        {events.map((event) => (
            <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
                
                <div class="lg:col-span-2 flex flex-col pt-2">
                    <span class="font-body font-black text-5xl md:text-6xl leading-tight tracking-tighter">
                        {event.date}
                    </span>
                    <span class="font-body font-black text-2xl mt-4 text-primary tracking-widest leading-none">
                        {event.time}
                    </span>
                </div>

                <div class="lg:col-span-6 group/poster relative aspect-[16/9] overflow-hidden bg-ink/5 rounded-sm">
                    <img 
                        src={event.poster} 
                        alt={event.title} 
                        class="w-full h-full object-cover transition-transform "
                    />
                    <div class="absolute inset-0 bg-primary/10 opacity-0 group-hover/poster:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                        <div class="w-20 h-20 bg-canvas rounded-full flex items-center justify-center p-5 shadow-xl translate-y-4 group-hover/poster:translate-y-0 transition-transform duration-500">
                             <img src="/assets/right-up.png" alt="View" class="w-full h-full object-contain" />
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-4 flex flex-col justify-between py-2">
                    <div>
                        <h3 class="text-4xl md:text-5xl font-title leading-tight mb-8">
                            {event.title}
                        </h3>
                        
                        <div class="flex flex-col gap-6">
                            <div class="flex items-center gap-3 group/loc cursor-pointer">
                                <div class="w-5 h-5 opacity-40 group-hover/loc:opacity-100 transition-opacity">
                                    <img src="/assets/location.png" alt="Loc" class="w-full h-full object-contain" />
                                </div>
                                <p class="font-body font-bold text-sm uppercase tracking-widest opacity-60 group-hover/loc:text-primary transition-colors">
                                    {event.location}
                                </p>
                            </div>
                            
                            <div class="flex items-center gap-4 mt-2">
                                <div class="w-10 h-10 rounded-full overflow-hidden border border-ink/10">
                                    <img src={event.organizerLogo} alt={event.organizer} class="w-full h-full object-cover" />
                                </div>
                                <div>
                                    <p class="font-body font-bold text-[10px] uppercase opacity-40 tracking-widest leading-none mb-1">Prepared By</p>
                                    <p class="font-body font-black text-lg leading-none uppercase">{event.organizer}</p>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>


            </div>
        ))}
    </div>
</section>