---
---

<section class="site-frame py-20 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 h-[600px]">
        
        <div class="relative group overflow-hidden bg-ink  flex flex-col justify-end p-12">
            <div class="absolute inset-0 opacity-40 group-hover:opacity-50  transition-all duration-700">
                <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?q=80&w=2070" class="w-full h-full object-cover grayscale" alt="Submit" />
            </div>
            
            <div class="relative z-10">
                <span class="font-body font-black text-xs uppercase tracking-[0.4em] text-primary mb-4 block">Recognition</span>
                <h2 class="text-canvas font-title text-6xl leading-[0.9] mb-8 max-w-xs">Show Ethiopia what you built.</h2>
                <a href="/submit" class="inline-block border-2 border-canvas/30 text-canvas px-8 py-4  font-body font-black text-sm uppercase tracking-widest hover:bg-canvas hover:text-ink transition-all">
                    Submit Website
                </a>
            </div>
        </div>

        <div class="relative group overflow-hidden bg-ink  flex flex-col justify-end p-12">
             <div class="absolute inset-0 opacity-30 group-hover:opacity-40  transition-all duration-700">
                <img src="assets/asset1.png" class="w-full h-full object-cover grayscale" alt="Membership" />
            </div>

            <div class="relative z-10">
                <span class="font-body font-black text-xs uppercase tracking-[0.4em] text-accent mb-4 block">Community</span>
                <h2 class="text-canvas font-title text-6xl leading-[0.9] mb-8 max-w-xs">Join the digital vanguard.</h2>
                <div class="flex gap-4">
                    <a href="/auth/signup" class="inline-block bg-canvas text-ink px-8 py-4  font-body font-black text-sm uppercase tracking-widest hover:bg-primary transition-all">
                        Create Account
                    </a>
                    <a href="/auth/login" class="inline-block border-2 border-canvas/30 text-canvas px-8 py-4  font-body font-black text-sm uppercase tracking-widest hover:bg-canvas hover:text-ink transition-all">
                        Log In
                    </a>
                </div>
            </div>
        </div>
    </div>

    
</section>