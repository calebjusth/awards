---

<section class="site-frame py-16 md:py-20 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="relative group overflow-hidden bg-ink flex flex-col justify-end p-8 md:p-12 min-h-[420px] md:min-h-[600px] ">
            <div class="absolute inset-0 transition-all duration-700">
                <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?q=80&w=2070" class="w-full h-full object-cover grayscale" alt="Submit" />
            </div>
            
            <div class="relative z-10">
                <span class="font-body text-caption text-primary mb-4 block">Recognition</span>
                <h2 class="text-canvas font-title mb-8 max-w-full sm:max-w-md">Show Ethiopia what you built.</h2>
                <a href="/submit" class="inline-block border-2 border-muted text-canvas px-6 py-4 sm:px-8 sm:py-4 font-body font-semibold text-caption hover:bg-canvas hover:text-ink transition-colors">
                    Submit Website
                </a>
            </div>
        </div>

        <div class="relative group overflow-hidden bg-ink flex flex-col justify-end p-8 md:p-12 min-h-[420px] md:min-h-[600px] ">
             <div class="absolute inset-0 transition-all duration-700">
                <img src="assets/asset1.png" class="w-full h-full object-cover grayscale" alt="Membership" />
            </div>

            <div class="relative z-10">
                <span class="font-body text-caption text-primary mb-4 block">Community</span>
                <h2 class="text-canvas font-title mb-8 max-w-full sm:max-w-md">Join the digital vanguard.</h2>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="/auth/signup" class="inline-block bg-canvas text-ink px-6 py-4 sm:px-8 sm:py-4 font-body font-semibold text-caption hover:bg-primary transition-colors">
                        Create Account
                    </a>
                    <a href="/auth/login" class="inline-block border-2 border-muted text-canvas px-6 py-4 sm:px-8 sm:py-4 font-body font-semibold text-caption hover:bg-canvas hover:text-ink transition-colors">
                        Log In
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>