---
// CTA.astro
---

<section class="site-frame py-16 md:py-20 relative">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Submit Website Card -->
        <div class="relative group overflow-hidden bg-ink flex flex-col justify-end p-6 sm:p-8 md:p-12 min-h-[380px] sm:min-h-[420px] md:min-h-[500px] lg:min-h-[600px]">
            <!-- Background Image with Dark Overlay -->
            <div class="absolute inset-0">
                <img src="https://images.unsplash.com/photo-1497215728101-856f4ea42174?q=80&w=2070" class="w-full h-full object-cover grayscale brightness-75" alt="Submit" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>
            </div>
            
            <div class="relative z-10">
                <span class="font-body text-caption text-muted mb-3 sm:mb-4 block">Recognition</span>
                <h2 class="text-white font-title mb-6 sm:mb-8 max-w-full sm:max-w-md text-2xl sm:text-3xl md:text-4xl leading-tight">
                    Show Ethiopia what you built.
                </h2>
                <a href="/submit" class="inline-block border-2 border-white/40 text-white px-5 py-3 sm:px-6 sm:py-4 md:px-8 md:py-4 font-body font-semibold text-captionhover:text-ink hover:border-white transition-all duration-300">
                    Submit Website
                </a>
            </div>
        </div>

        <!-- Membership Card -->
        <div class="relative group overflow-hidden bg-ink flex flex-col justify-end p-6 sm:p-8 md:p-12 min-h-[380px] sm:min-h-[420px] md:min-h-[500px] lg:min-h-[600px]">
            <!-- Background Image with Dark Overlay -->
            <div class="absolute inset-0">
                <img src="/assets/asset1.png" class="w-full h-full object-cover grayscale brightness-75" alt="Membership" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>
            </div>

            <div class="relative z-10">
                <span class="font-body text-caption text-muted mb-3 sm:mb-4 block">Community</span>
                <h2 class="text-white font-title mb-6 sm:mb-8 max-w-full sm:max-w-md text-2xl sm:text-3xl md:text-4xl leading-tight">
                    Join the digital vanguard.
                </h2>
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                    <a href="/auth/signup" class="inline-block text-center bg-white text-ink px-5 py-3 sm:px-6 sm:py-4 md:px-8 md:py-4 font-body font-semibold text-caption hover:bg-primary hover:text-white transition-all duration-300">
                        Create Account
                    </a>
                    <a href="/auth/login" class="inline-block text-center border-2 border-white/40 text-white px-5 py-3 sm:px-6 sm:py-4 md:px-8 md:py-4 font-body font-semibold text-caption  hover:text-ink hover:border-white transition-all duration-300">
                        Log In
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style is:global>
    /* Ensure text stays white and visible */
    .text-white {
        color: #ffffff;
    }
    
    /* Smooth transition for buttons */
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }
    
    /* Better image rendering */
    img {
        image-rendering: crisp-edges;
    }
    
    /* Responsive text adjustments */
    @media (max-width: 640px) {
        .min-h-\[380px\] {
            min-height: 380px;
        }
    }
</style>