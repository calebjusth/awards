---
const partners = [
  { name: "cbe", logo: "/sample/cbe.png" },
  { name: "dashen", logo: "/sample/dashen.png" },
  { name: "ethio", logo: "/sample/ethio.png" },
  { name: "sinqee", logo: "/sample/sinqee.png" },
  { name: "telebirr", logo: "/sample/telebirr.png" },
  { name: "gift-realestate", logo: "/sample/gift-realestate.png" },
];
---

<section class="site-frame py-32 ">
    <div class="flex flex-col items-center">
        <div class="text-center mb-24">
            <span class="font-body font-black text-sm uppercase tracking-[0.5em] text-primary">The Alliance</span>
            <h2 class="font-title text-7xl md:text-8xl mt-6 leading-none">Partners &<br/>Collaborators</h2>
        </div>

        <div class="w-full grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-12 items-center justify-items-center max-w-6xl">
            {partners.map((partner) => (
                <div class="group flex items-center justify-center h-40 w-full px-8 ">
                    <img 
                        src={partner.logo} 
                        alt={partner.name} 
                        class="max-h-20 w-auto object-contain grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 " 
                    />
                </div>
            ))}
        </div>
        
        <div class="mt-24">
            <a href="mailto:collab@yourdomain.com" class="group flex items-center gap-6 bg-ink text-canvas px-12 py-6  font-body font-black text-lg uppercase tracking-widest hover:bg-primary transition-all duration-300 hover:-translate-y-1 active:scale-95">
                become a partner
                <div class="w-10 h-10 bg-canvas/20 rounded-full flex items-center justify-center p-1.5 group-hover:rotate-45 transition-transform duration-300">
                    <img src="/assets/right-up.png" class="w-full h-full object-contain invert" alt="arrow" />
                </div>
            </a>
        </div>
    </div>
</section>