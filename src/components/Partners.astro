---
const partners = [
  { name: "cbe", logo: "/sample/cbe.png" },
  { name: "dashen", logo: "/sample/dashen.png" },
  { name: "ethio", logo: "/sample/ethio.png" },
  { name: "sinqee", logo: "/sample/sinqee.png" },
  { name: "telebirr", logo: "/sample/telebirr.png" },
  { name: "gift-realestate", logo: "/sample/gift-realestate.png" },
];
---

<section class="site-frame py-32 border-t border-muted">
    <div class="flex flex-col items-center">
        <div class="text-center mb-24 px-4">
            <span class="font-body text-caption text-primary">The Alliance</span>
            <h2 class="font-title mt-6">Partners &<br class="hidden md:block"/>Collaborators</h2>
        </div>

        <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-canvas border border-muted max-w-6xl">
            {partners.map((partner) => (
                <div class="group flex items-center justify-center h-48 md:h-64 bg-canvas px-8 transition-colors hover:bg-ink/5">
                    <img 
                        src={partner.logo} 
                        alt={partner.name} 
                        class="max-h-16 md:max-h-24 w-auto object-contain transition-all duration-500" 
                    />
                </div>
            ))}
        </div>
        
        <div class="mt-24">
            <a href="mailto:collab@yourdomain.com" class="group flex items-center gap-6 bg-ink text-canvas px-10 py-6 font-body font-semibold text-caption hover:bg-primary transition-colors duration-300">
                become a partner
                <div class="w-8 h-8 md:w-10 md:h-10 border border-muted flex items-center justify-center p-2 group-hover:rotate-45 transition-transform duration-300">
                    <img src="/assets/right-up.png" class="w-full h-full object-contain invert" alt="arrow" />
                </div>
            </a>
        </div>
    </div>
</section>