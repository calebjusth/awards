---
import { websites } from '../data/websites';

// Dynamic Date Logic
const today = new Date();
const formattedDate = today.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).toUpperCase();

// Get the first website award as featured
const featured = websites[0] || null;

if (!featured) {
  throw new Error('No website awards found');
}

const siteName = featured.title;
const agency = featured.developer;
const score = (
  (featured.scores.jury.creativity +
    featured.scores.jury.content +
    featured.scores.jury.usability +
    featured.scores.jury.interactivity) /
  4
).toFixed(2);
const siteImage = featured.heroImage;
const detailLink = `/websites/${featured.slug}`;
---

<section class="relative w-full flex flex-col py-12 sm:py-16 md:py-20 lg:py-24 site-frame">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end border-b-2 border-muted pb-6 sm:pb-8 mb-8 sm:mb-10 md:mb-12 gap-4 md:gap-0">
        <div class="flex flex-col gap-1 sm:gap-2">
            <span class="text-primary font-body text-caption">Site of Day</span>
            <h1 class="font-title text-2xl sm:text-3xl md:text-4xl">{siteName}</h1>
        </div>
        
        <div class="flex flex-row md:flex-col items-center md:items-end gap-3 md:gap-2">
            <div class="bg-primary px-3 sm:px-4 py-1 text-2xl sm:text-3xl md:text-4xl font-title rounded-sm" style="color: var(--color-canvas);">
                {score}
            </div>
            <p class="font-body text-caption text-ink text-left md:text-right">
                By {agency}<br class="hidden sm:inline md:hidden lg:inline"/>
                <span class="whitespace-nowrap">{formattedDate}</span>
            </p>
        </div>
    </div>

    <!-- Image Container with Link - object-contain to preserve design -->
    <a 
        href={detailLink} 
        class="relative group block"
        aria-label={`View ${siteName} details`}
    >
        <section class="mb-24 w-full">
        <div class="aspect-[16/9] w-full  overflow-hidden bg-ink/5">
          <img src={siteImage} alt={siteName} class="w-full h-full rounded-[2rem] object-cover" />
        </div>
      </section>
        
    </a>

</section>