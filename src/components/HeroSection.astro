---
// Dynamic Date Logic
const today = new Date();
const formattedDate = today.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric'
}).toUpperCase();

// Placeholder Data - This would eventually come from a CMS or Props
const siteName = "THE NOIR ARCHIVE";
const agency = "HELM CREATIVES";
const score = "9.42";
const siteImage = "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=2072";
---

<section class="relative w-full min-h-[180vh] flex flex-col pt-32 site-frame">
    
    <div class="flex flex-col md:flex-row justify-between items-end border-b-2 border-ink/10 pb-8 mb-12">
        <div class="flex flex-col gap-2">
            <span class="text-primary font-body text-xs tracking-[0.3em]">SITE OF THE DAY</span>
            <h1 class="text-7xl md:text-[12vw] font-title leading-[0.85]">{siteName}</h1>
        </div>
        
        <div class="flex flex-col items-end gap-2 mt-8 md:mt-0">
             <div class="bg-accent text-ink px-4 py-1 text-4xl font-title rounded-sm">
                {score}
            </div>
            <p class="font-body font-bold text-sm tracking-widest opacity-60 uppercase text-right leading-tight">
                BY {agency}<br/>
                {formattedDate}
            </p>
        </div>
    </div>

    <div class="relative w-full group cursor-pointer">
        
        <a href="#" class="absolute top-10 right-10 z-30 bg-canvas text-ink w-24 h-24 md:w-32 md:h-32 rounded-full flex items-center justify-center border-2 border-ink/10 hover:bg-primary hover:text-canvas hover:scale-110 transition-all duration-500  group">
            <i class="fa-solid fa-arrow-up-right text-3xl md:text-5xl -rotate-45"></i>
        </a>

        <div class="w-full h-auto overflow-hidden border-2 border-ink/10 rounded-sm bg-ink/5">
            <img 
                src={siteImage} 
                alt={siteName}
                class="w-full object-cover transition-transform duration-[2s] ease-out"
            />
        </div>
    </div>


</section>

<style>
    /* Ensure the image container has enough height to peek out in the first fold */
    img {
        min-height: 150vh; /* This forces the "scrollable screenshot" feel */
    }
</style>