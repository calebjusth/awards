---
const submissions = [
  {
    title: "ABYSSINIA BAKERY",
    author: "Kaleb Yohannes",
    authorImg: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1509440159596-0249088772ff?q=80&w=2072",
  },
  {
    title: "ETHIO-TECH HUB",
    author: "Studio 251",
    authorImg: "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2026",
  },
  {
    title: "LUCY'S LEGACY",
    author: "Freelance Creative",
    authorImg: "https://images.unsplash.com/photo-1531123897727-8f129e1688ce?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1519389428555-9809164732ff?q=80&w=2070",
  },
  {
    title: "RED SEA LOGISTICS",
    author: "Nati Design",
    authorImg: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1586717791821-3f44a563dc4c?q=80&w=2070",
  }
];
---

<section class="site-frame py-32 border-t border-ink/10">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
        <div>
            <h2 class="text-6xl md:text-8xl font-title leading-none ">Submissions.</h2>
            <p class="font-body font-black text-[10px] uppercase text-primary mt-4">The Community Feed</p>
        </div>
        <p class="font-body font-bold text-sm opacity-40 uppercase  max-w-[240px] text-right">
            Curated excellence from the local vanguard.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">
        {submissions.map((site) => (
            <div class="group flex flex-col gap-8">
                
                <div class="relative aspect-[16/10] overflow-hidden border border-ink/10 bg-ink/5">
                    <img 
                        src={site.thumbnail} 
                        alt={site.title} 
                        class="w-full h-full object-cover" 
                    />

                    <div class="absolute inset-0 bg-ink/20 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center gap-px">
                        <button class="w-16 h-16 bg-canvas border border-ink/10 flex items-center justify-center hover:bg-primary transition-colors">
                            <img src="/assets/save.png" alt="Save" class="w-5 h-5" />
                        </button>
                        <a href="#" class="w-16 h-16 bg-canvas border border-ink/10 flex items-center justify-center hover:bg-primary transition-colors">
                            <img src="/assets/right-up.png" alt="Launch" class="w-5 h-5" />
                        </a>
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="flex justify-between items-start">
                        <h3 class="text-5xl font-title leading-none  group-hover:text-primary transition-colors">
                            {site.title}
                        </h3>
                    </div>
                    
                    <div class="flex items-center gap-4 pt-4 border-t border-ink/5">
                        <div class="w-10 h-10 border border-ink/10 overflow-hidden bg-ink/5">
                            <img src={site.authorImg} alt={site.author} class="w-full h-full object-cover" />
                        </div>
                        <div class="flex flex-col">
                            <span class="font-body font-black text-[9px] uppercase opacity-30 tracking-[0.2em]">Submitted By</span>
                            <a href="#" class="font-body font-bold text-xs uppercase hover:underline decoration-primary underline-offset-4">
                                {site.author}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>