---
const submissions = [
  {
    title: "ABYSSINIA BAKERY",
    author: "Kaleb Yohannes",
    authorImg: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1509440159596-0249088772ff?q=80&w=2072",
  },
  {
    title: "ETHIO-TECH HUB",
    author: "Studio 251",
    authorImg: "https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2026",
  },
  {
    title: "LUCY'S LEGACY",
    author: "Freelance Creative",
    authorImg: "https://images.unsplash.com/photo-1531123897727-8f129e1688ce?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1519389428555-9809164732ff?q=80&w=2070",
  },
  {
    title: "RED SEA LOGISTICS",
    author: "Nati Design",
    authorImg: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=100",
    thumbnail: "https://images.unsplash.com/photo-1586717791821-3f44a563dc4c?q=80&w=2070",
  }
];
---

<section class="site-frame py-32 border-t border-muted">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
        <div>
            <h2 class="section-title">Submissions.</h2>
            <p class="font-body text-caption text-primary mt-4">The Community Feed</p>
        </div>
        <p class="font-body text-caption text-ink max-w-[240px] text-right">
            Curated excellence from the local vanguard.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">
        {submissions.map((site) => (
            <div class="group flex flex-col gap-8">
                
                <div class="relative aspect-[16/10] overflow-hidden border border-muted bg-canvas rounded-sm">
                    <img 
                        src={site.thumbnail} 
                        alt={site.title} 
                        class="w-full h-full object-cover" 
                    />

                    <div class="absolute inset-0 hidden group-hover:flex flex-col items-center justify-center gap-4 bg-ink/95 text-canvas p-4">
                        <div class="flex gap-4">
                            <button class="w-16 h-16 rounded-full bg-ink text-canvas border border-muted flex items-center justify-center hover:bg-primary transition-all">
                                <img src="/assets/save.png" alt="Save" class="w-6 h-6 object-contain" />
                            </button>
                            <a href="#" class="w-16 h-16 rounded-full bg-ink text-canvas border border-muted flex items-center justify-center hover:bg-primary transition-all">
                                <img src="/assets/right-up.png" alt="Launch" class="w-6 h-6 object-contain" />
                            </a>
                        </div>
                        <button class="rounded-sm bg-canvas text-ink px-6 py-3 font-body font-semibold hover:bg-primary hover:text-canvas transition-colors">
                            Vote Now
                        </button>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-center gap-4 md:hidden">
                    <button class="w-14 h-14 rounded-full bg-canvas text-canvas border border-muted flex items-center justify-center">
                        <img src="/assets/save.png" alt="Save" class="w-6 h-6 object-contain" />
                    </button>
                    <a href="#" class="w-14 h-14 rounded-full bg-canvas text-canvas border border-muted flex items-center justify-center">
                        <img src="/assets/right-up.png" alt="Launch" class="w-6 h-6 object-contain" />
                    </a>
                    <button class="rounded-sm bg-canvas text-ink px-6 py-3 font-body font-semibold  hover:text-canvas transition-colors">
                        Vote Now
                    </button>
                    </div>
                    
                    <div class="flex items-center gap-4 pt-4 border-t border-muted">
                        <div class="w-10 h-10 border border-muted overflow-hidden bg-canvas">
                            <img src={site.authorImg} alt={site.author} class="w-full h-full object-cover" />
                        </div>
                        <div class="flex flex-col">
                            <span class="font-body text-caption text-muted">Submitted by</span>
                            <a href="#" class="font-body text-caption font-semibold hover:underline decoration-primary underline-offset-4">
                                {site.author}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>