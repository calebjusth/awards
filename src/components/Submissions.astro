<section class="site-frame py-24 border-t border-ink/5">
    <div class="flex flex-col md:flex-row justify-between items-baseline mb-12 gap-4">
        <h2 class="text-5xl font-title">Recent Submissions</h2>
        <p class="font-body font-bold text-sm opacity-40 uppercase tracking-[0.3em]">Fresh from the community</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {submissions.map((site) => (
            <div class="group flex flex-col gap-4">
                
                <div class="relative aspect-video overflow-hidden border border-ink/5 bg-ink/5">
                    <img 
                        src={site.thumbnail} 
                        alt={site.title} 
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />

                    <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-end justify-end p-4 gap-3">
                        <button class="w-10 h-10 rounded-full bg-canvas/10 backdrop-blur-md border border-canvas/20 hover:bg-primary hover:border-primary transition-all p-2.5">
                            <img src="/assets/save.png" alt="Save" class="w-full h-full object-contain invert" />
                        </button>
                        <a href="#" class="w-10 h-10 rounded-full bg-canvas/10 backdrop-blur-md border border-canvas/20 hover:bg-primary hover:border-primary transition-all p-2.5">
                            <img src="/assets/right-up.png" alt="Launch" class="w-full h-full object-contain invert" />
                        </a>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <h3 class="text-xl font-body tracking-tight">{site.title}</h3>
                    
                    <div class="flex items-center gap-2">
                        <div class="w-6 h-6 rounded-full overflow-hidden border border-ink/10">
                            <img src={site.authorImg} alt={site.author} class="w-full h-full object-cover" />
                        </div>
                        <a href="#" class="font-body font-black text-[10px] uppercase tracking-widest opacity-60 hover:text-primary transition-colors">
                            {site.author}
                        </a>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>