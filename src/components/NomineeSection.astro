---
const nominees = [
  {
    title: "VIRTUAL ETHIOPIA",
    author: "Dawit Abraham",
    authorImg: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1964",
    category: "Web Design"
  },
  {
    title: "NEBULA DASHBOARD",
    author: "Helm Creatives",
    authorImg: "https://images.unsplash.com/photo-1614850523296-e8c041de239b?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2026",
    category: "Development"
  },
  {
    title: "ZOMA MUSEUM REDESIGN",
    author: "Sara Tekle",
    authorImg: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=2000",
    category: "Experience"
  }
];
---

<section class="site-frame py-32 border-t border-ink/5">
    <div class="flex justify-between items-end mb-16">
        <div>
            <h2 class="text-6xl md:text-8xl font-title">The Nominees</h2>
            <p class="font-body font-bold text-xl opacity-40 uppercase tracking-widest mt-4">The next standard of excellence.</p>
        </div>
        <a href="/nominees" class="hidden md:block font-body font-black border-b-2 border-primary pb-1 hover:text-primary transition-all">VIEW ALL NOMINEES</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-20 gap-x-12">
        {nominees.map((site) => (
            <div class="group flex flex-col gap-6">
                <div class="relative aspect-[4/5] overflow-hidden border border-ink/10 bg-ink/5 rounded-sm">
                    <img 
                        src={site.thumbnail} 
                        alt={site.title} 
                        class="w-full h-full object-cover transition-all duration-700"
                    />

                    <div class="absolute inset-0 bg-ink/80 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col items-center justify-center gap-6">
                        
                        <div class="flex gap-4">
                            <button class="w-14 h-14 rounded-full bg-canvas/10 border border-canvas/20 hover:bg-primary hover:border-primary transition-all flex items-center justify-center p-4">
                                <img src="/assets/save.png" alt="Save" class="w-full h-full object-contain invert" />
                            </button>
                            <a href="#" target="_blank" class="w-14 h-14 rounded-full bg-canvas/10 border border-canvas/20 hover:bg-primary hover:border-primary transition-all flex items-center justify-center p-4">
                                <img src="/assets/right-up.png" alt="Launch" class="w-full h-full object-contain invert" />
                            </a>
                        </div>

                        <button class="bg-accent text-ink px-8 py-3 font-body text-1xl hover:scale-105 transition-transform active:scale-95">
                            VOTE NOW
                        </button>
                    </div>

                    <div class="absolute top-6 left-6 z-10">
                        <span class="bg-canvas/90 backdrop-blur text-[10px] font-body font-black px-3 py-1 uppercase tracking-widest border border-ink/10">
                            {site.category}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <h3 class="text-3xl font-title leading-none group-hover:text-primary transition-colors">
                        {site.title}
                    </h3>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full border border-ink/10 overflow-hidden bg-white">
                                <img src={site.authorImg} alt={site.author} class="w-full h-full object-cover" />
                            </div>
                            <a href="#" class="font-body font-black text-sm uppercase tracking-widest hover:text-primary transition-colors">
                                {site.author}
                            </a>
                        </div>
                        
                        <div class="h-[1px] flex-grow mx-4 bg-ink/10"></div>
                        
                        <span class="font-body font-bold text-[10px] opacity-30 tracking-[0.2em]">2026</span>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>