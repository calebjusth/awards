---
const nominees = [
  {
    title: "VIRTUAL ETHIOPIA",
    author: "Dawit Abraham",
    authorImg: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1964",
    category: "Web Design"
  },
  {
    title: "NEBULA DASHBOARD",
    author: "Helm Creatives",
    authorImg: "https://images.unsplash.com/photo-1614850523296-e8c041de239b?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2026",
    category: "Development"
  },
  {
    title: "ZOMA MUSEUM REDESIGN",
    author: "Sara Tekle",
    authorImg: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=100&h=100&auto=format&fit=crop",
    thumbnail: "https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=2000",
    category: "Experience"
  }
];
---

<section class="site-frame py-32 border-t border-muted">
    <div class="flex justify-between items-end mb-16">
        <div>
            <h2 class="section-title">The Nominees</h2>
            <p class="font-body text-caption text-ink mt-4">The next standard of excellence.</p>
        </div>
        <a href="/nominees" class="hidden md:block font-body font-semibold border-b-2 border-primary pb-1 hover:text-primary transition-colors">View all nominees</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-y-20 gap-x-12">
        {nominees.map((site) => (
            <div class="group flex flex-col gap-6">
                <div class="relative aspect-[4/5] overflow-hidden border border-muted bg-canvas rounded-sm">
                    <img 
                        src={site.thumbnail} 
                        alt={site.title} 
                        class="w-full h-full object-cover transition-all duration-700"
                    />

                    <div class="absolute inset-0 bg-ink/95 hidden group-hover:flex flex-col items-center justify-center gap-6 text-canvas p-4">
                        <div class="flex gap-4">
                            <button class="w-14 h-14 rounded-full bg-canvas text-canvas border border-muted  hover:border-primary transition-all flex items-center justify-center p-4">
                                <img src="/assets/save.png" alt="Save" class="w-full h-full object-contain" />
                            </button>
                            <a href="#" target="_blank" class="w-14 h-14 rounded-full bg-canvas text-canvas border border-muted  hover:border-primary transition-all flex items-center justify-center p-4">
                                <img src="/assets/right-up.png" alt="Launch" class="w-full h-full object-contain" />
                            </a>
                        </div>

                        <button class="bg-canvas text-ink px-8 py-3 font-body font-semibold">
                            Vote Now
                        </button>
                    </div>
                    <div class="mt-4 flex items-center justify-center gap-4 md:hidden">
                        <button class="w-14 h-14 rounded-full bg-ink text-canvas border border-muted flex items-center justify-center p-4">
                            <img src="/assets/save.png" alt="Save" class="w-full h-full object-contain" />
                        </button>
                        <a href="#" target="_blank" class="w-14 h-14 rounded-full bg-ink text-canvas border border-muted flex items-center justify-center p-4">
                            <img src="/assets/right-up.png" alt="Launch" class="w-full h-full object-contain" />
                        </a>
                        <button class="rounded-sm bg-canvas text-ink px-6 py-3 font-body font-semibold hover:bg-primary hover:text-canvas transition-colors">
                            Vote Now
                        </button>
                    </div>

                    <div class="absolute top-6 left-6 z-10">
                        <span class="bg-canvas border border-muted text-ink text-caption font-body px-3 py-1">
                            {site.category}
                        </span>
                    </div>
                </div>

                <div class="flex flex-col gap-4">
                    <h3 class="font-title leading-none group-hover:text-primary transition-colors">
                        {site.title}
                    </h3>
                    
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full border border-muted overflow-hidden bg-canvas">
                                <img src={site.authorImg} alt={site.author} class="w-full h-full object-cover" />
                            </div>
                            <a href="#" class="font-body font-semibold text-caption hover:text-primary transition-colors">
                                {site.author}
                            </a>
                        </div>
                        
                        <div class="h-[1px] flex-grow mx-4 bg-muted"></div>
                        
                        <span class="font-body text-caption text-muted">2026</span>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>