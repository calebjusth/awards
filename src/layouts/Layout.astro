---
import '../styles/global.css';

interface Props {
    title: string;
    description?: string;
}

const { title, description = "The Standard of Ethiopian Web Design." } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title} | YET</title>
        <meta name="description" content={description} />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    </head>
    <body class="selection:bg-primary selection:text-canvas bg-canvas overflow-x-hidden">
        
        <header class="fixed top-6 left-1/2 -translate-x-1/2 z-40 w-[95%] max-w-7xl">
            <nav class="glass-card flex items-center justify-between px-8 py-4 bg-canvas/90 ">
                <a href="/" class="font-title text-4xl hover:text-primary transition-colors">YET</a>

                <div class="hidden md:flex flex-1 mx-6 items-center bg-ink/5 px-6 py-2 border border-ink/10 focus-within:border-primary transition-all">
                    <i class="fa-solid fa-magnifying-glass opacity-40"></i>
                    <input type="text" placeholder="Search Inspo..." class="bg-transparent border-none focus:ring-0 text-base ml-4 w-full font-bold placeholder:text-ink/30 uppercase tracking-widest" />
                </div>

                <div class="flex items-center gap-4">
                    <div class="hidden sm:flex items-center gap-6 text-sm font-bold uppercase tracking-widest">
                        <a href="/auth/login" class="hover:text-primary transition-colors">Login</a>
                        <a href="/auth/signup" class="bg-primary text-canvas px-6 py-2 hover:brightness-110 transition-all">Sign Up</a>
                    </div>

                    <div class="flex items-center justify-center w-11 h-11 rounded-full border border-ink/10 bg-ink/5 overflow-hidden shadow-sm">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=256&q=80" alt="Profile avatar" class="w-full h-full object-cover grayscale" />
                    </div>

                    <button id="menu-toggle" class="group flex flex-col gap-1.5 p-2 cursor-pointer">
                        <span class="w-8 h-1 bg-ink group-hover:bg-primary transition-colors"></span>
                        <span class="w-8 h-1 bg-ink group-hover:bg-primary transition-colors"></span>
                    </button>
                </div>
            </nav>
        </header>

        <div id="full-page-menu" class="fixed inset-0 z-[9999] bg-primary/95 backdrop-blur-sm -translate-y-full transition-transform duration-700 ease-[cubic-bezier(0.85,0,0.15,1)] flex items-center justify-center overflow-y-auto">
            <button id="menu-close" class="absolute top-6 right-6 text-canvas p-4 z-50 hover:scale-110 transition-transform">
                <i class="fa-solid fa-xmark text-5xl"></i>
            </button>
            
            <div class="grid grid-cols-1 md:grid-cols-2 w-full h-full">
                <nav class="flex flex-col justify-center px-12 md:px-24 gap-6 text-canvas">
                    <a href="/winners" class="font-title text-6xl md:text-8xl hover:text-ink transition-all">WINNERS</a>
                    <a href="/nominees" class="font-title text-6xl md:text-8xl hover:text-ink transition-all">NOMINEES</a>
                    <a href="/events" class="font-title text-6xl md:text-8xl hover:text-ink transition-all">EVENTS</a>
                    <a href="/gallery" class="font-title text-6xl md:text-8xl hover:text-ink transition-all">GALLERY</a>
                </nav>
                
                <div class="hidden md:block relative overflow-hidden bg-ink">
                    <img src="https://images.unsplash.com/photo-1550684848-fac1c5b4e853?q=80&w=2070" alt="Design Concept" class="w-full h-full object-cover opacity-60" />
                </div>
            </div>
        </div>

        <main class="relative z-10 pt-28 md:pt-32">
            <slot />
        </main>

        <footer class="bg-canvas overflow-hidden text-ink p-10 md:p-20 flex flex-col relative border-t border-ink/5">
            <div class="absolute top-20 right-0 w-96 h-96 bg-primary rounded-full blur-[120px] opacity-10 animate-drift pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto w-full grid grid-cols-1 md:grid-cols-4 gap-10 lg:gap-16">
                <div class="md:col-span-2">
                    <h2 class="font-title text-6xl md:text-8xl xl:text-[15rem] leading-[0.8] mb-8 text-primary">YET</h2>
                    <p class="font-am bold text-3xl max-w-md">የኢትዮጵያ ዲጂታል ስታንዳርድ።</p>
                    <p class="font-bold text-xl mt-4 opacity-40 uppercase tracking-widest">Curating the future of the Ethiopian web.</p>
                </div>

                <div class="flex flex-col gap-6">
                    <h3 class="font-body text-primary  ">Explore</h3>
                    <div class="flex flex-col gap-3 font-body font-bold text-2xl">
                        <a href="/about" class="hover:text-primary transition-colors">About</a>
                        <a href="/faq" class="hover:text-primary transition-colors">FAQ</a>
                        <a href="/contact" class="hover:text-primary transition-colors">Contact</a>
                    </div>
                </div>

                <div class="flex flex-col gap-6">
                    <h3 class="font-body text-primary  ">Stay Updated</h3>
                    <p class="opacity-60 text-sm font-body font-bold uppercase tracking-widest">Join the movement. No spam.</p>
                    
                    <div class="flex items-center border-b-2 border-ink/10 pb-2 focus-within:border-primary transition-colors">
                        <input type="email" placeholder="YOUR EMAIL..." class="bg-transparent border-none focus:ring-0 text-sm w-full font-body font-bold placeholder:text-ink/30 uppercase tracking-widest" />
                        <button class="text-ink hover:text-primary transition-colors"><i class="fa-solid fa-arrow-right"></i></button>
                    </div>

                    <div class="flex items-center gap-6 mt-6 text-3xl">
                        <a href="#" class="hover:text-primary transition-all"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="hover:text-primary transition-all"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#" class="hover:text-primary transition-all"><i class="fa-brands fa-telegram"></i></a>
                        <a href="#" class="hover:text-primary transition-all"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </div>
            </div>

            <div class="mt-20 pt-10 border-t border-ink/10 flex flex-col md:flex-row justify-between items-end gap-4 font-body font-bold">
                <div class="text-sm opacity-40 uppercase tracking-widest">© 2026 YET. ALL RIGHTS RESERVED.</div>
                <p class="text-sm uppercase tracking-widest opacity-40 text-right">Powered by Helm Creative</p>
            </div>
        </footer>

        <script>
            const menuToggle = document.getElementById('menu-toggle');
            const menuClose = document.getElementById('menu-close');
            const menu = document.getElementById('full-page-menu');

            menuToggle?.addEventListener('click', () => {
                menu?.classList.remove('-translate-y-full');
                menu?.classList.add('translate-y-0');
                document.body.style.overflow = 'hidden';
            });

            menuClose?.addEventListener('click', () => {
                menu?.classList.remove('translate-y-0');
                menu?.classList.add('-translate-y-full');
                document.body.style.overflow = 'auto';
            });
        </script>
    </body>
</html>