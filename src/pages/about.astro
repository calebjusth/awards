---
import Layout from '../layouts/Layout.astro';

const title = "About";
const description = "Wabi Awards is Ethiopia’s leading platform recognizing outstanding website designers and developers. We celebrate human creativity beyond templates and AI defaults through awards, events, and community summits.";

// SEO: Structured Data for the Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Wabi Awards",
  "url": "https://wabi-sigma.vercel.app/",
  "logo": "https://wabi-sigma.vercel.app/assets/logo.png",
  "description": "Wabi Awards is Ethiopia’s premier web design recognition platform, spotlighting creativity and innovation beyond templates and AI defaults.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Addis Ababa",
    "addressCountry": "ET"
  }
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <main class="site-frame py-24 md:py-40">
        
        <header class="mb-32 md:mb-48 border-b border-muted pb-16 md:pb-24">
            <h1 class="heading-1 mb-12 max-w-[12ch]">About<br/>Wabi Awards.</h1>
            <div class="flex flex-col md:flex-row justify-between items-start gap-8">
                <p class="body-copy max-w-3xl">
                    <span class="font-am">ዋቢ</span> (Wabi) represents originality and excellence. Wabi Awards is Ethiopia’s platform that recognizes the best website designers and developers, proving that human creativity stands above templates and AI defaults. Our mission is to inspire, challenge, and celebrate those who push digital design to new heights.
                </p>
            </div>
        </header>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40 md:mb-64">
            <div class="order-2 lg:order-1">
                <span class="eyebrow mb-6 block">01 / Vision</span>
                <h2 class="section-heading mb-8">Why Wabi Exists.</h2>
                <p class="body-copy mb-6">
                    Ethiopia’s digital landscape is growing fast, but too often limited by generic templates and automated defaults. Wabi Awards was created to set a new standard, a place where originality, craft, and innovation are recognized and rewarded.
                </p>
                <p class="body-copy">
                    We believe the browser is a canvas and code is a craft. Wabi exists to spotlight designers and developers who elevate web design into art, shaping Ethiopia’s digital future.
                </p>
            </div>
            <div class="order-1 lg:order-2 overflow-hidden">
                <img 
                    src="/og-image.png" 
                    alt="Creative Ethiopian web design showcase" 
                    class="w-full h-full object-contain"
                />
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40 md:mb-64">
            <div class=" overflow-hidden">
                <img 
                    src="/event.png" 
                    alt="Networking and recognition events for Ethiopian developers" 
                    class="w-full h-full object-contain"
                />
            </div>
            <div>
                <span class="eyebrow mb-6 block">02 / Community</span>
                <h2 class="section-heading mb-8">Events & Recognition.</h2>
                <p class="body-copy mb-8">
                    Wabi is more than awards. We prepare recognition ceremonies, developer summits, and networking sessions — from coffee meetups to high-profile galas. These events connect Ethiopia’s digital talent, foster collaboration, and celebrate achievements.
                </p>
                <a href="/events" class="button-secondary">
                    View Upcoming Events
                </a>
            </div>
        </section>

       <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40">
    <div class="order-2 lg:order-1">
        <span class="eyebrow mb-6 block">03 / Merch</span>
        <h2 class="section-heading mb-8">Gear for Developers.</h2>
        <p class="body-copy mb-8">
            Wabi Awards isn’t only about recognition — we also bring creativity into everyday life. Our official merch line features coding-inspired T‑shirts, hoodies, mugs, and accessories designed for Ethiopian developers and designers. Each piece celebrates the spirit of originality and the pride of being part of the Wabi community.
        </p>
        <p class="body-copy mb-8">
            Whether you’re at a summit, a coffee meetup, or coding late at night, Wabi merch lets you wear your passion and connect with fellow innovators.
        </p>
        <div class="flex gap-4">
             <a  class="button-secondary">
                Coming Soon
             </a>
        </div>
    </div>
    <div class="order-1 lg:order-2 overflow-hidden">
        <img 
            src="/sample.png" 
            alt="Wabi Awards developer T-shirt and merch collection" 
            class="w-full h-full object-contain"
        />
    </div>
</section>


        <footer class="text-center py-24 border-t border-muted">
            <h3 class="section-heading mb-12">Ready to go beyond templates?</h3>
            <div class="flex flex-col md:flex-row justify-center gap-6">
                <a href="/submit" class="link-secondary font-semibold border-b-2 border-primary pb-1">Submit Your Work</a>
                <a href="/nominees" class="link-secondary font-semibold border-b-2 border-primary pb-1">See Past Winners</a>
            </div>
        </footer>
    </main>
</Layout>
