---
import Layout from '../layouts/Layout.astro';

const title = "About | yet — The Digital Vanguard of Ethiopia";
const description = "Discover the story behind yet. We are an editorial platform dedicated to Ethiopian digital excellence through events, curated books, and the annual Selection.";

// SEO: Structured Data for the Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "yet",
  "url": "https://awards-gamma-nine.vercel.app/",
  "logo": "https://awards-gamma-nine.vercel.app/assets/logo.png",
  "description": "An editorial collective and digital awards platform based in Ethiopia.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Addis Ababa",
    "addressCountry": "ET"
  }
};
---

<Layout title={title} description={description}>
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <main class="site-frame py-24 md:py-40">
        
        <header class="mb-32 md:mb-48 border-b border-ink/10 pb-16 md:pb-24">
            <h1 class="font-title text-[18vw] leading-[0.75] mb-12">Who<br/>We Are.</h1>
            <div class="flex flex-col md:flex-row justify-between items-start gap-8">
                <p class="font-body text-2xl md:text-4xl max-w-3xl leading-tight">
                    <span class="font-am">የት</span> meaning “where” in Amharic is the place where exceptional web design lives. We spotlight bold, original work and challenge designers and agencies to move beyond generic templates and AI clichés. Our mission is to raise a new generation of world-class designers pushing the craft forward.
                </p>
            </div>
        </header>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40 md:mb-64">
            <div class="order-2 lg:order-1">
                <span class="font-body font-black text-[10px] uppercase text-primary mb-6 block">01 / The Beginning</span>
                <h2 class="font-title text-6xl md:text-8xl leading-none mb-8">Why We Started.</h2>
                <p class="font-body text-lg md:text-xl opacity-70 leading-relaxed mb-6">
                    The Ethiopian web was expanding, but its soul was being lost in generic templates and uninspired builds. We started <span class="text-ink font-bold">yet</span> to create a standard—a digital North Star for developers who believe that code is a craft and the browser is a canvas.
                </p>
                <p class="font-body text-lg md:text-xl opacity-70 leading-relaxed">
                    We didn't just want a gallery; we wanted a vanguard. A place where the best projects are archived, analyzed, and celebrated as part of our national digital heritage.
                </p>
            </div>
            <div class="order-1 lg:order-2 aspect-[4/5] bg-ink/5 overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1558591710-4b4a1ae0f04d?q=80&w=1974" 
                    alt="Abstract editorial representation of beginnings" 
                    class="w-full h-full object-cover grayscale  transition-all duration-1000"
                />
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40 md:mb-64">
            <div class="aspect-[4/5] bg-ink/5 overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1540575861501-7ad05823c951?q=80&w=2070" 
                    alt="Digital conference and community events" 
                    class="w-full h-full object-cover grayscale  transition-all duration-1000"
                />
            </div>
            <div>
                <span class="font-body font-black text-[10px] uppercase text-primary mb-6 block">02 / Community & Pulse</span>
                <h2 class="font-title text-6xl md:text-8xl leading-none mb-8">We Prepare<br/>Events.</h2>
                <p class="font-body text-lg md:text-xl opacity-70 leading-relaxed mb-8">
                    Beyond the screen, we facilitate high-density networking and technical symposiums. From our annual "Selection" gala to monthly developer mixers in Addis, we bridge the gap between digital talent and industry leaders.
                </p>
                <a href="/events" class="inline-block border border-ink/20 px-8 py-4 font-body font-black text-[10px] uppercase hover:bg-ink hover:text-canvas transition-all">
                    View Upcoming Schedule
                </a>
            </div>
        </section>

        <section class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-24 items-center mb-40">
            <div class="order-2 lg:order-1">
                <span class="font-body font-black text-[10px] uppercase text-primary mb-6 block">03 / Tangible Knowledge</span>
                <h2 class="font-title text-6xl md:text-8xl leading-none mb-8">Curated<br/>Books.</h2>
                <p class="font-body text-lg md:text-xl opacity-70 leading-relaxed mb-8">
                    We believe in the permanence of print. Every year, we publish <span class="italic">The Index</span>—a high-fidelity hardback book featuring the winners of the Selection, technical deep-dives, and essays on the future of African design.
                </p>
                <div class="flex gap-4">
                     <a href="/shop" class="bg-ink text-canvas px-8 py-4 font-body font-black text-[10px] uppercase hover:bg-primary transition-all">
                        Browse the Library
                    </a>
                </div>
            </div>
            <div class="order-1 lg:order-2 aspect-[4/5] bg-ink/5 overflow-hidden">
                <img 
                    src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?q=80&w=2112" 
                    alt="Minimalist book design and print editorial" 
                    class="w-full h-full object-cover grayscale  transition-all duration-1000"
                />
            </div>
        </section>

        <footer class="text-center py-24 border-t border-ink/10">
            <h3 class="font-title text-5xl md:text-7xl mb-12">Ready to join the<br/>vanguard?</h3>
            <div class="flex flex-col md:flex-row justify-center gap-6">
                <a href="/submit" class="font-body font-black text-[10px] uppercase tracking-widest border-b-2 border-primary pb-1">Submit Your Work</a>
                <a href="/nominees" class="font-body font-black text-[10px] uppercase tracking-widest border-b-2 border-primary pb-1">Get Inspiration</a>
            </div>
        </footer>
    </main>
</Layout>