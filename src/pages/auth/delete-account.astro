---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Terminate Account | yet">
    <main class="site-frame min-h-[90vh] flex flex-col items-center justify-center">
        <div class="w-full max-w-md mx-auto">
            
            <div class="mb-12">
                <span class="font-body  uppercase text-primary">
                    Delete Account
                </span>
            </div>

            <header class="mb-10">
                <h1 class="font-title text-6xl md:text-7xl leading-[0.8] mb-6">
                    Leave the <br/>
                    Vanguard.
                </h1>
                <p class="font-body opacity-70 max-w-[320px] leading-relaxed">
                    This action is irreversible. Your sites, votes, and status will be wiped from the database forever.
                </p>
            </header>
            
            <form action="/" class="flex flex-col gap-10">
                <div class="group flex flex-col gap-3">
                    <label class="font-body  uppercase opacity-40 group-focus-within:opacity-100 transition-opacity">
                        Type DELETE to confirm
                    </label>
                    <input 
                        type="text" 
                        placeholder="DELETE" 
                        class="bg-transparent border-b-2 border-primary/20 py-2 outline-none focus:border-primary transition-colors font-body text-2xl text-primary placeholder:opacity-10" 
                        required 
                    />
                </div>
                
                <button type="submit" class="bg-primary justify-center text-canvas py-6 px-8 font-body text-xs uppercase hover:bg-ink transition-all duration-300 flex justify-between items-center group">
                    <span>Delete Account</span>
                </button>
            </form>

            <div class="mt-10 mb-10 flex flex-col md:flex-row md:items-baseline gap-4 md:gap-6">
                <span class=" font-body  uppercase opacity-40">
                    Change you mind?
                </span>
                <a href="/" class="font-body text-2xl uppercase text-ink hover:text-primary transition-colors flex items-center gap-2 group">
                    <span>Go Back</span>
                    <img 
                        src="/assets/right-up.png" 
                        alt="" 
                        class="h-[0.8em] w-auto transition-transform duration-300 group-hover:-translate-x-1 group-hover:rotate-180" 
                    />
                </a>
            </div>
        </div>
    </main>
</Layout>