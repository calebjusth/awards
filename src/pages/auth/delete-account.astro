---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Terminate Account">
    <main class="site-frame min-h-screen flex items-center py-24">
        <div class="mx-auto w-full max-w-2xl space-y-10">
            <div class="max-w-xl">
                <p class="text-primary text-strong mb-3">Delete Account</p>
                <h1 class="heading-1 mb-4">Permanent account removal.</h1>
                <p class="body-copy max-w-xl">
                    This action cannot be undone. Your account, submissions, and history will be permanently deleted.
                </p>
            </div>

            <div class="card-panel">
                <form action="/" class="space-y-6">
                    <label class="form-label">
                        Type DELETE to confirm
                        <input
                            type="text"
                            name="confirm"
                            placeholder="DELETE"
                            class="form-input"
                            required
                        />
                    </label>

                    <button type="submit" class="button-primary w-full">
                        Delete Account
                    </button>
                </form>

                <p class="form-footnote mt-6">
                    Not ready yet? <a class="link-secondary" href="/">Go back</a> safely.
                </p>
            </div>
        </div>
    </main>
</Layout>