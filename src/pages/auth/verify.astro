---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Verify Identity | yet">
    <main class="site-frame min-h-[90vh] flex flex-col items-center justify-center">
        <div class="w-full max-w-md mx-auto">
            
            <div class="mb-12">
                <span class="font-body  uppercase text-primary">
                    Verify Email
                </span>
            </div>

            <header class="mb-10">
                <h1 class="font-title text-6xl md:text-7xl leading-[0.8] mb-6">
                    Prove it's <br/>
                    <span class="text-primary">actually</span> you.
                </h1>
                <p class="font-body  opacity-70 max-w-[280px] leading-relaxed">
                    We just dropped a 6-digit code in your inbox. Paste it here to finish.
                </p>
            </header>
            
            <form action="/dashboard" class="flex flex-col gap-10">
                <div class="group flex flex-col gap-3">
                    <label class="font-body  uppercase opacity-40 group-focus-within:opacity-100 transition-opacity">
                        One-Time Password (OTP)
                    </label>
                    <input 
                        type="text" 
                        maxlength="6" 
                        placeholder="000000" 
                        class="bg-transparent border-b-2 border-ink/60 py-2 outline-none focus:border-primary transition-colors font-title text-5xl placeholder:opacity-10" 
                        required 
                    />
                </div>
                
                <button type="submit" class="bg-ink text-canvas py-6 px-8 font-body text-xs uppercase hover:bg-primary transition-all duration-300 flex justify-between items-center group">
                    <span>Confirm & Enter</span>
                    <span class="transform group-hover:translate-x-1 transition-transform">→</span>
                </button>
            </form>

            
                <div class="mt-10 mb-10 flex flex-col md:flex-row md:items-baseline gap-4 md:gap-6">
                    <span class="font-body  uppercase opacity-40 whitespace-nowrap">
                        Didn't get the mail?
                    </span>
                    <button class="font-body text-2xl uppercase text-ink hover:text-primary transition-colors flex items-center gap-2 group cursor-pointer">
                        <span>Resend</span>
                        <img 
                            src="/assets/right-up.png" 
                            alt="" 
                            class="h-[0.8em] w-auto transition-transform duration-300 group-hover:rotate-45" 
                        />
                    </button>
                </div>
           

        </div>
    </main>
</Layout>