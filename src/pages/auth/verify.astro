---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Verification">
    <main class="site-frame min-h-screen flex items-center py-24">
        <div class="mx-auto w-full max-w-2xl space-y-10">
            <div class="max-w-xl">
                <p class="text-primary text-strong mb-3">Verify Email</p>
                <h1 class="heading-1 mb-4">Confirm your code.</h1>
                <p class="body-copy max-w-xl">
                    Enter the 6-digit code we sent to your inbox to complete sign in.
                </p>
            </div>

            <div class="card-panel">
                <form action="/dashboard" class="space-y-6">
                    <label class="form-label">
                        One-Time Password (OTP)
                        <input
                            type="text"
                            name="otp"
                            maxlength="6"
                            placeholder="000000"
                            class="form-input"
                            required
                        />
                    </label>

                    <button type="submit" class="button-primary w-full">
                        Confirm & Enter
                    </button>
                </form>

                <p class="form-footnote mt-6">
                    Didn&apos;t receive a code? <button class="button-secondary" type="button">Resend</button>
                </p>
            </div>
        </div>
    </main>
</Layout>