---
import Layout from '../layouts/Layout.astro';

const title = "Contact Us";
const description = "Connect with yet. Reach out via our secure form or Contact us on Telegram and WhatsApp.";
---

<Layout title={title} description={description}>
    <section class="site-frame py-20 min-h-screen flex items-center">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 w-full items-center">
            
            <div class="lg:col-span-5">
                <p class="text-primary text-strong mb-3">Contact Us</p>
                <h1 class="heading-1 mb-6">We&apos;re ready to answer your questions.</h1>
                <p class="body-copy max-w-xl">
                    Send us a message and we&apos;ll respond as soon as possible. For fast support, connect with our team on WhatsApp or Telegram.
                </p>
                <div class="mt-10 flex flex-wrap items-center gap-4">
                    <a href="https://wa.me/yournumber" class="button-secondary">
                        <i class="fa-brands fa-whatsapp"></i>
                        WhatsApp
                    </a>
                    <a href="https://t.me/yourusername" class="button-secondary">
                        <i class="fa-brands fa-telegram"></i>
                        Telegram
                    </a>
                </div>
            </div>

            <div class="card-panel lg:col-span-7 xl:col-span-6 mx-auto lg:mx-0">
                <form id="contact-form" action="#" method="POST" class="space-y-6">
                    <div class="hidden" aria-hidden="true">
                        <input type="text" name="hp_confirm_email" id="hp_field" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="grid gap-6 md:grid-cols-2">
                        <label class="form-label">
                            Full Name
                            <input type="text" name="name" placeholder="Caleb Wesley" class="form-input" required />
                        </label>
                        <label class="form-label">
                            Email Address
                            <input type="email" name="email" placeholder="example@gmail.com" class="form-input" required />
                        </label>
                    </div>

                    <div class="grid gap-6 md:grid-cols-2">
                        <label class="form-label">
                            Phone Number
                            <input type="tel" name="phone" placeholder="+251 ..." class="form-input" />
                        </label>
                        <label class="form-label">
                            Topic
                            <select name="topic" class="form-select">
                                <option>General Inquiry</option>
                                <option>Partnership</option>
                                <option>Site Submission</option>
                            </select>
                        </label>
                    </div>

                    <label class="form-label">
                        Message
                        <textarea name="message" rows="5" placeholder="How can we help?" class="form-textarea" required></textarea>
                    </label>

                    <button type="submit" class="button-primary w-full">
                        Send Message
                    </button>
                </form>
            </div>

        </div>
    </section>
</Layout>

<script is:inline>
    const form = document.getElementById('contact-form');
    const honeypot = document.getElementById('hp_field');

    form.addEventListener('submit', (e) => {
        // If the honeypot field is filled, it's a bot
        if (honeypot.value !== "") {
            e.preventDefault();
            console.warn("Bot detected. Submission blocked.");
            alert("Something went wrong with your submission. Please try again.");
            return false;
        }
        
        // Human submission logic can go here
        console.log("Human submission verified.");
    });
</script>