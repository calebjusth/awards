---
import Layout from '../layouts/Layout.astro';

const title = "Contact | yet — Digital Excellence in Ethiopia";
const description = "Connect with yet. Reach out via our secure form or Contact us on Telegram and WhatsApp.";
---

<Layout title={title} description={description}>
    <section class="site-frame py-20 min-h-screen flex items-center">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 w-full items-center">
            
            <div class="lg:col-span-5">
                <div class="mb-10">
                    <h1 class="text-7xl md:text-9xl font-title leading-[0.8] mb-6 ">Drop a<br/>Message.</h1>
                    <p class="font-body text-lg opacity-50 leading-relaxed max-w-xs">
                        We are <span class="text-ink font-bold">yet</span>. and we are here to serve! How can we help you?
                    </p>
                </div>

                <div class="flex items-center gap-8 mt-10">
                    <a href="https://wa.me/yournumber" class="hover:text-green-500 transition-colors">
                        <i class="fa-brands fa-whatsapp text-4xl"></i>
                    </a>
                    <a href="https://t.me/yourusername" class="hover:text-blue-500 transition-colors">
                        <i class="fa-brands fa-telegram text-4xl"></i>
                    </a>
                  
                </div>
            </div>

            <div class="lg:col-span-7  p-8 md:p-14  border ">
                <form id="contact-form" action="#" method="POST" class="flex flex-col gap-10">
                    
                    <div class="hidden" aria-hidden="true">
                        <input type="text" name="hp_confirm_email" id="hp_field" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        <div class="flex flex-col gap-2">
                            <label class="font-body font-black text-[10px] uppercase tracking-widest opacity-40">Full Name</label>
                            <input type="text" name="name" placeholder="Caleb Wesley" class="bg-transparent border-b border-ink/20 py-4 focus:border-primary outline-none transition-all font-body text-lg" required />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-body font-black text-[10px] uppercase tracking-widest opacity-40">Email Address</label>
                            <input type="email" name="email" placeholder="example@gmail.com" class="bg-transparent border-b border-ink/20 py-4 focus:border-primary outline-none transition-all font-body text-lg" required />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                        <div class="flex flex-col gap-2">
                            <label class="font-body font-black text-[10px] uppercase tracking-widest opacity-40">Phone Number</label>
                            <input type="tel" name="phone" placeholder="+251 ..." class="bg-transparent border-b border-ink/20 py-4 focus:border-primary outline-none transition-all font-body text-lg" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="font-body font-black text-[10px] uppercase tracking-widest opacity-40">Topic</label>
                            <select name="topic" class="bg-transparent border-b border-ink/20 py-4 focus:border-primary outline-none transition-all font-body text-lg appearance-none cursor-pointer">
                                <option>General Inquiry</option>
                                <option>Partnership</option>
                                <option>Site Submission</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label class="font-body font-black text-[10px] uppercase tracking-widest opacity-40">Message</label>
                        <textarea name="message" rows="3" placeholder="How can we help?" class="bg-transparent border-b border-ink/20 py-4 focus:border-primary outline-none transition-all font-body text-lg resize-none" required></textarea>
                    </div>

                    <button type="submit" class="bg-primary text-canvas w-full py-6  font-body font-black text-sm uppercase tracking-[0.4em] hover:bg-ink transition-all active:scale-95">
                        Submit Message
                    </button>
                </form>
            </div>

        </div>
    </section>
</Layout>

<script is:inline>
    const form = document.getElementById('contact-form');
    const honeypot = document.getElementById('hp_field');

    form.addEventListener('submit', (e) => {
        // If the honeypot field is filled, it's a bot
        if (honeypot.value !== "") {
            e.preventDefault();
            console.warn("Bot detected. Submission blocked.");
            alert("Something went wrong with your submission. Please try again.");
            return false;
        }
        
        // Human submission logic can go here
        console.log("Human submission verified.");
    });
</script>