---
import Layout from '../layouts/Layout.astro';

const title = "Nominees";
const description = "Discover the finest digital experiences in Ethiopia. Filter by industry and tech stack.";

// Mock Data with Developer Avatars
const nominees = [
  { 
    title: "Kaleb's Studio", 
    category: "Portfolio", 
    tech: "React", 
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=2072",
    devAvatar: "https://ui-avatars.com/api/?name=Caleb&background=FF5733&color=fff"
  },
  { 
    title: "Zemen Bank UI", 
    category: "Finance", 
    tech: "Astro", 
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2015",
    devAvatar: "https://ui-avatars.com/api/?name=ZB&background=000&color=fff"
  },
  { 
    title: "Ethio-Market", 
    category: "E-commerce", 
    tech: "Django", 
    image: "https://images.unsplash.com/photo-1557821552-17105176677c?q=80&w=2089",
    devAvatar: "https://ui-avatars.com/api/?name=EM&background=primary&color=fff"
  },
  { 
    title: "Abyssinia Real Estate", 
    category: "Real Estate", 
    tech: "Webflow", 
    image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070",
    devAvatar: "https://ui-avatars.com/api/?name=AR&background=333&color=fff"
  }
];

const categories = ["All Categories", "Ecommerce", "Portfolio", "Real Estate", "Finance"];
const techStacks = ["All Tech", "React", "Astro", "Webflow", "Django", "Next.js"];
---

<Layout title={title} description={description}>
    <main class="site-frame py-24">
        
        <header class="mb-16">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-muted pb-12">
                <div>
                    <h1 class="heading-1 mb-4">Nominees.</h1>
                    <p class="eyebrow">The Selection 2026</p>
                </div>
                
                <div class="flex gap-4 flex-wrap">
                    <div class="relative group">
                        <select class="form-select pr-12">
                            {categories.map(cat => <option>{cat}</option>)}
                        </select>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-40">
                            <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                    </div>

                    <div class="relative group">
                        <select class="form-select pr-12">
                            {techStacks.map(tech => <option>{tech}</option>)}
                        </select>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none opacity-40">
                            <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="2"/></svg>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            {nominees.map((item) => (
                <div class="group flex flex-col">
                    <div class="relative aspect-[16/10] overflow-hidden border border-muted bg-muted/10">
                        <img 
                            src={item.image} 
                            alt={item.title} 
                            class="w-full h-full object-cover" 
                        />
                        <div class="absolute top-6 left-6">
                            <span class="accent-tag">{item.tech}</span>
                        </div>
                    </div>
                    
                    <div class="pt-8 flex items-start justify-between">
                        <div class="flex items-center gap-5">
                            <img src={item.devAvatar} alt="dev" class="w-12 h-12 grayscale group-hover:grayscale-0 transition-all border border-muted" />
                            <div>
                                <h3 class="section-heading mb-1">{item.title}</h3>
                                <p class="text-small text-muted">{item.category}</p>
                            </div>
                        </div>
                        
                        <a href="#" class="button-outline w-12 h-12 p-0">
                            <img src="/assets/right-up.png" class="w-10 h-10" alt="view" />
            ))}
        </div>

        <nav class="mt-40 border-t border-muted pt-16 flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="flex items-center gap-4">
                <span class="eyebrow text-muted">Records</span>
                <span class="section-heading">01 — 12</span>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
                <button class="button-outline">Previous</button>
                <div class="flex px-4 items-center gap-6">
                    <span class="section-heading text-primary">01</span>
                    <span class="section-heading text-muted cursor-pointer">02</span>
                    <span class="section-heading text-muted cursor-pointer">03</span>
                </div>
                <button class="button-primary">Next Page</button>
            </div>
        </nav>
    </main>
</Layout>