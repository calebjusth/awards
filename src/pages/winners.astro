---
import Layout from '../layouts/Layout.astro';

const yearWinner = {
  title: "Aura Morphosis",
  developer: "Helm Creatives",
  category: "Immersive Narrative",
  year: "2025",
  image: "https://assets.awwwards.com/awards/media/cache/thumb_880_660/submissions/2026/04/69d768dd8b896711383791.png",
  description: "Pioneering a new era of fluid typography and spatial navigation."
};

const weekWinners = [
  { title: "Kinetica", dev: "Studio X", img: "https://picsum.photos/seed/w1/1200/800" },
  { title: "Oasis UI", dev: "Nova Digital", img: "https://picsum.photos/seed/w2/1200/800" },
  { title: "The Void", dev: "Dark Mode", img: "https://picsum.photos/seed/w3/1200/800" },
  { title: "Ether", dev: "Flux Agency", img: "https://picsum.photos/seed/w4/1200/800" },
];
---

<Layout title="Winners Circle">
    <main class="site-frame py-12 md:py-16 lg:py-24">
        
        <!-- Grand Prix Section -->
        <section class="mb-24 md:mb-32 lg:mb-40">
            <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-8 md:mb-12 border-b border-muted pb-6 md:pb-8">
                <div>
                    <p class="eyebrow mb-2">Site of the Year</p>
                    <h1 class="heading-1">Grand Prix.</h1>
                </div>
                <span class="text-2xl md:text-3xl font-title font-light text-muted">{yearWinner.year}</span>
            </header>

            <!-- Card Container -->
            <div class="bg-canvas overflow-hidden border border-muted">
                <!-- Image Container -->
                <div class="aspect-[16/10] md:aspect-[21/9] w-full flex items-center justify-center p-4 md:p-8 bg-ink/5">
                    <img 
                        src={yearWinner.image} 
                        alt={yearWinner.title} 
                        class="w-full h-full object-contain" 
                    />
                </div>
                
                <!-- Info Overlay -->
                <div class="p-6 md:p-8 lg:p-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-t border-muted">
                    <div class="space-y-2">
                        <h2 class="text-2xl md:text-3xl font-title font-bold tracking-tight">{yearWinner.title}</h2>
                        <p class="text-sm md:text-base text-ink/60 max-w-lg">{yearWinner.description}</p>
                    </div>
                    <div class="flex items-center gap-6 flex-shrink-0">
                        <div class="text-left md:text-right">
                            <p class="eyebrow text-muted">Developer</p>
                            <p class="font-body font-semibold">{yearWinner.developer}</p>
                        </div>
                        <a 
                            href="#" 
                            class="w-12 h-12 rounded-full border border-muted flex items-center justify-center text-ink hover:border-primary hover:text-primary transition-colors"
                            aria-label="View project"
                        >
                            <i class="fas fa-arrow-right text-sm"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Recent Laureates Section -->
        <section>
            <header class="mb-8 md:mb-12">
                <h2 class="text-2xl md:text-3xl font-title font-bold tracking-tight">Recent Laureates.</h2>
                <div class="h-px w-full bg-muted mt-4"></div>
            </header>

            <!-- Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 lg:gap-16">
                {weekWinners.map((site) => (
                    <a href="#" class="group block no-underline">
                        <!-- Image Container -->
                        <div class="relative aspect-[16/10] mb-5 overflow-hidden border border-muted bg-ink/5">
                            <img 
                                src={site.img} 
                                alt={site.title} 
                                class="w-full h-full object-cover" 
                            />
                        </div>
                        
                        <!-- Details -->
                        <div class="flex justify-between items-baseline border-b border-muted pb-4">
                            <div class="flex flex-wrap items-baseline gap-2 md:gap-3">
                                <h3 class="font-title font-bold text-base md:text-lg tracking-tight uppercase">{site.title}</h3>
                                <span class="text-muted">—</span>
                                <p class="font-body text-sm text-ink/60 italic">{site.dev}</p>
                            </div>
                            <div class="text-muted group-hover:text-primary group-hover:translate-x-1 transition-all duration-300">
                                <i class="fas fa-arrow-right text-xs"></i>
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        </section>

        <!-- CTA Section -->
        <footer class="mt-32 md:mt-40 lg:mt-48 py-16 md:py-20 lg:py-24 border-t border-muted text-center">
            <h3 class="text-3xl md:text-5xl lg:text-6xl font-title font-bold mb-8 md:mb-12 tracking-tight">
                Enter the circle.
            </h3>
            <a href="/submit" class="button-primary inline-flex items-center gap-3">
                Submit Your Project
                <i class="fas fa-arrow-right text-sm"></i>
            </a>
        </footer>
    </main>
</Layout>